{
  "name": "linux-system-mcp",
  "version": "1.1.2",
  "description": "MCP server for Linux desktop notifications, interactive dialogs, and shell access",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepare": "npm run build"
  },
