{
  "name": "linux-system-mcp",
  "version": "1.3.0",
  "description": "MCP server for Linux desktop GUI automation (mouse, keyboard, screenshot), notifications, interactive dialogs, shell execution, and privileged operations",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node tests/verify_tool_search.mjs",
    "prepare": "npm run build"
  },
  "bin": {
    "linux-system-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "linux",
    "mouse",
    "keyboard",
    "screenshot",
    "desktop-automation",
    "gui-automation",
    "uinput",
    "ydotool",
    "xdotool",
    "notifications",
    "kdialog",
    "zenity",
    "dialogs",
    "sudo",
    "desktop",
    "xdg",
    "shell",
    "notify-send",
    "pkexec",
    "human-in-the-loop",
    "tool-search"
  ],
  "author": "DGPL (Durbhasi Gurukulam Private Limited)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
